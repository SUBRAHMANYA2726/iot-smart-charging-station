# Private ThingSpeak telemetry channel. Use the channel Read API Key here.
THINGSPEAK_TELEMETRY_CHANNEL_ID=replace-with-telemetry-channel-id
THINGSPEAK_TELEMETRY_READ_API_KEY=replace-with-telemetry-read-key
# Separate private command channel. The dashboard reads its state and writes requests.
THINGSPEAK_CONTROL_CHANNEL_ID=replace-with-command-channel-id
THINGSPEAK_CONTROL_READ_API_KEY=replace-with-command-read-key
THINGSPEAK_CONTROL_WRITE_API_KEY=replace-with-command-write-key
# Use a unique password. It is not the ThingSpeak password.
DASHBOARD_PASSWORD=replace-with-a-long-unique-password
# Firebase server-side Firestore storage. Keep the service-account JSON in the
# Render secret environment only. Never put it in a browser file or Git.
FIREBASE_PROJECT_ID=chargesense-station-01
FIREBASE_SERVICE_ACCOUNT_JSON=
# Set to your Vercel origin (and optional custom domain), comma-separated.
PUBLIC_APP_ORIGINS=https://your-vercel-project.vercel.app
PORT=3000
